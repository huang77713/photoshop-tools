{
  "manifestVersion": 5,
  "id": "com.huangtools.photoshoptools.externalmenu",
  "name": "PS Tools Menu External JS",
  "version": "0.0.5",
  "main": "index.html",
  "host": {
    "app": "PS",
    "minVersion": "25.0.0",
    "data": {
      "apiVersion": 2,
      "loadEvent": "use"
    }
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "externalMenuPanel",
      "label": {
        "default": "PS Tools Menu External JS"
      },
      "minimumSize": {
        "width": 280,
        "height": 380
      },
      "preferredDockedSize": {
        "width": 390,
        "height": 760
      },
      "preferredFloatingSize": {
        "width": 420,
        "height": 850
      },
      "icons": [
        {
          "width": 23,
          "height": 23,
          "path": "icons/panel.png",
          "scale": [
            1
          ],
          "theme": [
            "all"
          ]
        }
      ],
      "maximumSize": {
        "width": 1300,
        "height": 2000
      }
    }
  ],
  "icons": [
    {
      "width": 48,
      "height": 48,
      "path": "icons/plugin.png",
      "scale": [
        1
      ],
      "theme": [
        "all"
      ],
      "species": "pluginList"
    }
  ]
}
