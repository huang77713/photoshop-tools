{
  "manifestVersion": 5,
  "id": "com.huangtools.photoshoptools",
  "name": "Photoshop Tools",
  "version": "1.0.3",
  "main": "index.html",
  "host": {
    "app": "PS",
    "minVersion": "25.0.0",
    "data": {
      "apiVersion": 2,
      "loadEvent": "use"
    }
  },
  "requiredPermissions": {
    "localFileSystem": "request"
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "photoshopToolsPanel",
      "label": {
        "default": "Photoshop Tools"
      },
      "minimumSize": {
        "width": 300,
        "height": 440
      },
      "maximumSize": {
        "width": 1500,
        "height": 2000
      },
      "preferredDockedSize": {
        "width": 390,
        "height": 750
      },
      "preferredFloatingSize": {
        "width": 450,
        "height": 830
      },
      "icons": [
        {
          "width": 23,
          "height": 23,
          "path": "icons/nine-slice.png",
          "scale": [
            1
          ],
          "theme": [
            "all"
          ]
        }
      ]
    }
  ],
  "icons": [
    {
      "width": 48,
      "height": 48,
      "path": "icons/plugin.png",
      "scale": [
        1
      ],
      "theme": [
        "all"
      ],
      "species": "pluginList"
    }
  ]
}
