{
  "manifestVersion": 5,
  "id": "com.huangtools.photoshoptools.staticmenu",
  "name": "PS Tools Static Menu Test",
  "version": "0.0.3",
  "main": "index.html",
  "host": {
    "app": "PS",
    "minVersion": "25.0.0",
    "data": {
      "apiVersion": 2,
      "loadEvent": "use"
    }
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "staticMenuPanel",
      "label": {
        "default": "PS Tools Static Menu Test"
      },
      "minimumSize": {
        "width": 240,
        "height": 220
      },
      "preferredDockedSize": {
        "width": 300,
        "height": 420
      },
      "preferredFloatingSize": {
        "width": 320,
        "height": 450
      },
      "icons": [
        {
          "width": 23,
          "height": 23,
          "path": "icons/panel.png",
          "scale": [
            1
          ],
          "theme": [
            "all"
          ]
        }
      ]
    }
  ],
  "icons": [
    {
      "width": 48,
      "height": 48,
      "path": "icons/plugin.png",
      "scale": [
        1
      ],
      "theme": [
        "all"
      ],
      "species": "pluginList"
    }
  ]
}
